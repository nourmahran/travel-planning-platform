# Copy to .env and fill in real values. Never commit .env.

# --- Required: the app refuses to start without these ---
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
# Long random string used to sign session tokens
JWT_SECRET=<long-random-secret>
# Stripe TEST mode only (sk_test_...). Live keys are rejected.
STRIPE_SECRET_KEY=sk_test_<your-test-key>
# Printed by: stripe listen --forward-to localhost:3000/api/payments/webhook
STRIPE_WEBHOOK_SECRET=whsec_<your-webhook-secret>

# --- Optional ---
PORT=3000
PLATFORM_CURRENCY=USD
# Optional comma-separated ISO currency codes added to those in Countries.csv, e.g. USD,EUR,EGP
SUPPORTED_CURRENCIES=USD
# FXRatesAPI (ITN-18 budget currency conversion); key stays on the backend
FX_RATES_API_KEY=
FX_RATES_API_BASE_URL=
FX_RATES_TIMEOUT_MS=
# Flight seat-hold length in minutes
BOOKING_HOLD_MINUTES=
# Seeded administrator account (admins cannot self-register)
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
# Comma-separated frontend origins allowed by CORS
CORS_ORIGIN=
# Dev-only payment confirm endpoint; ignored when NODE_ENV=production
ENABLE_DEV_PAYMENT_ENDPOINTS=false
