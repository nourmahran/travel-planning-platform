# ---------------------------------------------------------------------------
# Member 3 - Hotels module (copy these keys into the team .env)
# ---------------------------------------------------------------------------

# Shared MongoDB Atlas connection string owned by Member 1 / Member 2.
# Transactions are required: the URI must point to a replica set (Atlas always does).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# HTTP port used by the standalone sandbox.
PORT=3000

# Platform currency enforced by Member 4 (PAY-18). All hotel/room prices are
# stored as integer minor units (cents) in this currency.
PLATFORM_CURRENCY=USD

# Temporary flag for the standalone sandbox only. When true the dev auth guard
# trusts x-user-id / x-user-role headers. MUST be false once Member 1's cookie
# session guard is wired in.
AUTH_DEV_MODE=true

# Shared secret used by Member 4 (payments) to call the internal booking
# endpoints. Leave empty to block those endpoints (admins can still call them).
INTERNAL_API_KEY=

# Hold duration for room inventory (minutes). The requirement fixes this at 10.
HOTEL_HOLD_MINUTES=10

# Require the guest to accept the hotel policies before the payment can be confirmed.
REQUIRE_POLICY_ACCEPTANCE=true

# Background jobs: expire holds, complete past stays, purge old locks.
ENABLE_HOTEL_JOBS=true
