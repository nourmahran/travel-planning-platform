MONGODB_URI=

# Payments (PAY-01..04) — Stripe TEST MODE only (sk_test_..., never sk_live_)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Single platform currency, lowercase ISO code (PAY-04)
PLATFORM_CURRENCY=usd
# Hold duration for PendingPayment bookings (FLT-22 / HTL-18)
BOOKING_HOLD_MINUTES=10
# Dev-only Swagger helper (dev confirm endpoint). Must be false in production.
ENABLE_DEV_PAYMENT_ENDPOINTS=true
JWT_SECRET=
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
NODE_ENV=development
PORT=3000
ADMIN_EMAIL=admin@travel.local
ADMIN_PASSWORD=
ADMIN_NAME=Platform Admin

# Exchange rates (ITN-18). The public API is free and keyless; the key is only
# needed if the provider starts requiring one. Never expose these to a client.
FX_RATES_API_BASE_URL=https://api.fxratesapi.com
FX_RATES_API_KEY=
FX_RATES_TIMEOUT_MS=5000
